<mjml>
  <mj-head>
    <mj-attributes>
      <mj-all font-family="Inter, system-ui, -apple-system, 'Segoe UI', Arial, sans-serif" />
      <mj-section padding="0" />
      <mj-column padding="0" />
      <mj-text color="#18181b" font-size="14px" line-height="24px" padding="0" />
      <mj-button
        font-size="14px"
        font-weight="500"
        line-height="20px"
        border-radius="8px"
        inner-padding="10px 20px"
        padding="0"
      />
    </mj-attributes>
    <mj-style inline="inline">
      .code div {
        white-space: nowrap;
        font-variant-numeric: tabular-nums;
      }
    </mj-style>
  </mj-head>
</mjml>
