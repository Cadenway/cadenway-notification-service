<mj-table
  border="1px solid #e4e4e7"
  cellpadding="0"
  cellspacing="0"
  font-size="14px"
  line-height="20px"
  padding="0 0 20px 0"
>
  <tr style="border-bottom: 1px solid #e4e4e7">
    <td style="padding: 10px 16px; color: #5f616a; width: 128px; vertical-align: top">Appareil</td>
    <td style="padding: 10px 16px; font-weight: 500; vertical-align: top">{{ deviceLabel }}</td>
  </tr>
  <tr style="border-bottom: 1px solid #e4e4e7">
    <td style="padding: 10px 16px; color: #5f616a; width: 128px; vertical-align: top">
      Adresse IP
    </td>
    <td style="padding: 10px 16px; font-weight: 500; vertical-align: top; word-break: break-all">
      {{ ipAddress }}
    </td>
  </tr>
  <tr>
    <td style="padding: 10px 16px; color: #5f616a; width: 128px; vertical-align: top">Date</td>
    <td style="padding: 10px 16px; font-weight: 500; vertical-align: top">{{ dateLabel }}</td>
  </tr>
</mj-table>
