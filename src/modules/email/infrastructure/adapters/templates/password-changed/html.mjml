<mjml lang="fr">
  <mj-head>
    <mj-include path="../partials/head.mjml" />
    <mj-preview>Si ce n’était pas vous, sécurisez votre compte maintenant.</mj-preview>
  </mj-head>
  <mj-body background-color="#f2f2f4" width="600px">
    <mj-wrapper padding="32px 20px">
      <mj-include path="../partials/security-header.mjml" />
      <mj-section
        background-color="#ffffff"
        border="1px solid #e4e4e7"
        border-radius="12px"
        padding="32px"
      >
        <mj-column>
          <mj-text font-size="20px" line-height="28px" font-weight="600" padding="0 0 20px 0">
            Mot de passe modifié
          </mj-text>
          <mj-text padding="0 0 20px 0">
            Le mot de passe de votre compte vient d’être modifié.{{#if sessionsClosed}} Par
            sécurité, <strong>{{ sessionsClosed }}</strong
            >.{{else}} Vos autres sessions restent ouvertes.{{/if}}
          </mj-text>
          <mj-include path="../partials/client-rows.mjml" />
          <mj-divider border-width="1px" border-color="#e4e4e7" padding="0 0 20px 0" />
          <mj-text padding="0 0 20px 0">
            <strong>Ce n’était pas vous ?</strong> Réinitialisez votre mot de passe tout de suite,
            puis prévenez l’administrateur de votre organisation.
          </mj-text>
          <mj-button
            href="{{secureAccountUrl}}"
            align="left"
            background-color="#ffffff"
            color="#18181b"
            border="1px solid #e4e4e7"
          >
            Sécuriser mon compte
          </mj-button>
        </mj-column>
      </mj-section>
      <mj-include path="../partials/security-footer.mjml" />
    </mj-wrapper>
  </mj-body>
</mjml>
