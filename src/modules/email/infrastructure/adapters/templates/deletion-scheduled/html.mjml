<mjml lang="fr">
  <mj-head>
    <mj-include path="../partials/head.mjml" />
    <mj-preview
      >Votre compte sera supprimé le {{ deleteDate }}. Vous pouvez encore annuler.</mj-preview
    >
  </mj-head>
  <mj-body background-color="#f2f2f4" width="600px">
    <mj-wrapper padding="32px 20px">
      <mj-include path="../partials/security-header.mjml" />
      <mj-section
        background-color="#ffffff"
        border="1px solid #e4e4e7"
        border-radius="12px"
        padding="32px"
      >
        <mj-column>
          <mj-text font-size="20px" line-height="28px" font-weight="600" padding="0 0 20px 0">
            Suppression programmée le {{ deleteDayMonth }}
          </mj-text>
          <mj-text padding="0 0 20px 0">
            Comme demandé, votre compte et vos données personnelles seront supprimés définitivement
            dans <strong>{{ delayLabel }}</strong
            >. Jusque-là, une connexion suffit pour annuler.
          </mj-text>
          <mj-table
            border="1px solid #e4e4e7"
            cellpadding="0"
            cellspacing="0"
            font-size="14px"
            line-height="20px"
            padding="0 0 20px 0"
          >
            <tr style="border-bottom: 1px solid #e4e4e7">
              <td style="padding: 10px 16px; color: #5f616a; width: 128px; vertical-align: top">
                Supprimé
              </td>
              <td style="padding: 10px 16px; font-weight: 500; vertical-align: top">
                Profil, préférences, jetons d’API, sessions
              </td>
            </tr>
            <tr>
              <td style="padding: 10px 16px; color: #5f616a; width: 128px; vertical-align: top">
                Conservé
              </td>
              <td style="padding: 10px 16px; font-weight: 500; vertical-align: top">
                Tâches et documents de l’organisation, attribués à « Ancien membre »
              </td>
            </tr>
          </mj-table>
          <mj-button href="{{cancelUrl}}" align="left" background-color="#7c3aed" color="#ffffff">
            Annuler la suppression
          </mj-button>
        </mj-column>
      </mj-section>
      <mj-include path="../partials/security-footer.mjml" />
    </mj-wrapper>
  </mj-body>
</mjml>
