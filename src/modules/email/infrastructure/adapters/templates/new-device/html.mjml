<mjml lang="fr">
  <mj-head>
    <mj-include path="../partials/head.mjml" />
    <mj-preview
      >{{ ipAddress }} · {{ shortDateLabel }}. Vérifiez vos sessions si ce n’était pas
      vous.</mj-preview
    >
  </mj-head>
  <mj-body background-color="#f2f2f4" width="600px">
    <mj-wrapper padding="32px 20px">
      <mj-include path="../partials/security-header.mjml" />
      <mj-section
        background-color="#ffffff"
        border="1px solid #e4e4e7"
        border-radius="12px"
        padding="32px"
      >
        <mj-column>
          <mj-text font-size="20px" line-height="28px" font-weight="600" padding="0 0 20px 0">
            Nouvelle connexion détectée
          </mj-text>
          <mj-text padding="0 0 20px 0">
            Votre compte vient d’être utilisé sur un appareil que nous ne connaissions pas.
          </mj-text>
          <mj-include path="../partials/client-rows.mjml" />
          <mj-text padding="0 0 20px 0">
            Si c’était vous, vous n’avez rien à faire. Sinon, fermez cette session et changez votre
            mot de passe.
          </mj-text>
          <mj-button href="{{sessionsUrl}}" align="left" background-color="#7c3aed" color="#ffffff">
            Vérifier mes sessions
          </mj-button>
        </mj-column>
      </mj-section>
      <mj-include path="../partials/security-footer.mjml" />
    </mj-wrapper>
  </mj-body>
</mjml>
