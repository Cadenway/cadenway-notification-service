<mjml lang="{{language}}">
  <mj-head>
    <mj-include path="../partials/head.mjml" />
    <mj-preview>{{ preview }}</mj-preview>
  </mj-head>
  <mj-body background-color="#f2f2f4" width="600px">
    <mj-wrapper padding="32px 20px">
      <mj-include path="../partials/header.mjml" />
      <mj-section
        background-color="#ffffff"
        border="1px solid #e4e4e7"
        border-radius="12px"
        padding="32px"
      >
        <mj-column>
          <mj-text font-size="20px" line-height="28px" font-weight="600" padding="0 0 12px 0">
            {{ title }}
          </mj-text>
          <mj-text padding="0 0 20px 0">{{ preview }}</mj-text>
          <mj-button href="{{appUrl}}" align="left" background-color="#7c3aed" color="#ffffff">
            {{ openLabel }}
          </mj-button>
        </mj-column>
      </mj-section>
      <mj-section padding="24px 8px 0 8px">
        <mj-column>
          <mj-text align="center" color="#5f616a" font-size="12px" line-height="20px">
            <a href="{{preferencesUrl}}" style="color: #5f616a">{{ preferencesLabel }}</a>
          </mj-text>
        </mj-column>
      </mj-section>
    </mj-wrapper>
  </mj-body>
</mjml>
