<mjml lang="fr">
  <mj-head>
    <mj-include path="../partials/head.mjml" />
    <mj-preview
      >Un code pour finir votre inscription sur Cadenway, valable
      {{ validityMinutes }} minutes.</mj-preview
    >
  </mj-head>
  <mj-body background-color="#f2f2f4" width="600px">
    <mj-wrapper padding="32px 20px">
      <mj-include path="../partials/security-header.mjml" />
      <mj-section
        background-color="#ffffff"
        border="1px solid #e4e4e7"
        border-radius="12px"
        padding="32px"
      >
        <mj-column>
          <mj-text font-size="20px" line-height="28px" font-weight="600" padding="0 0 20px 0">
            Bienvenue sur Cadenway
          </mj-text>
          <mj-text padding="0 0 20px 0">
            Bonjour{{#if recipientName}} {{ recipientName }}{{/if}}, votre compte a été créé.
            Confirmez votre adresse avec ce code pour commencer à organiser vos tâches et vos
            espaces.
          </mj-text>
          <mj-text
            css-class="code"
            container-background-color="#f6f6f8"
            align="center"
            font-family="ui-monospace, SFMono-Regular, Menlo, Consolas, monospace"
            font-size="30px"
            line-height="40px"
            font-weight="600"
            letter-spacing="0.3em"
            padding="20px 16px 4px 16px"
          >
            {{ code }}
          </mj-text>
          <mj-text
            container-background-color="#f6f6f8"
            align="center"
            color="#5f616a"
            font-size="12px"
            line-height="16px"
            padding="0 16px 20px 16px"
          >
            Valable {{ validityMinutes }} minutes, une seule fois
          </mj-text>
          <mj-text color="#5f616a" font-size="12px" line-height="20px" padding="20px 0 0 0">
            Vous n’avez pas créé de compte ? Ignorez cet e-mail : rien ne sera activé.
          </mj-text>
        </mj-column>
      </mj-section>
      <mj-include path="../partials/security-footer.mjml" />
    </mj-wrapper>
  </mj-body>
</mjml>
