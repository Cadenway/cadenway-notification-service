<mjml lang="fr">
  <mj-head>
    <mj-include path="../partials/head.mjml" />
    <mj-style inline="inline">
      .badge {
        display: inline-block;
        width: 44px;
        height: 44px;
        line-height: 44px;
        font-size: 14px;
        font-weight: 600;
        text-align: center;
        vertical-align: middle;
      }
      .inviter {
        border-radius: 22px;
        background-color: #e6e6e9;
        color: #18181b;
      }
      .organization {
        border-radius: 8px;
        background-color: #18181b;
        color: #ffffff;
      }
      .arrow {
        display: inline-block;
        padding: 0 10px;
        color: #5f616a;
        font-size: 16px;
        line-height: 44px;
        vertical-align: middle;
      }
    </mj-style>
    <mj-preview
      >Rôle proposé : {{ roleLabel }}. L’invitation expire le {{ expiryDate }}.</mj-preview
    >
  </mj-head>
  <mj-body background-color="#f2f2f4" width="600px">
    <mj-wrapper padding="32px 20px">
      <mj-include path="../partials/header.mjml" />
      <mj-section
        background-color="#ffffff"
        border="1px solid #e4e4e7"
        border-radius="12px"
        padding="32px"
      >
        <mj-column>
          <mj-text align="center" padding="8px 0 12px 0">
            <span class="badge inviter">{{ inviterInitials }}</span
            ><span class="arrow">→</span
            ><span class="badge organization">{{ organizationInitials }}</span>
          </mj-text>
          <mj-text
            align="center"
            font-size="20px"
            line-height="28px"
            font-weight="600"
            padding="0 0 2px 0"
          >
            {{ organizationName }}
          </mj-text>
          <mj-text align="center" color="#5f616a" font-size="12px" line-height="16px">
            {{ memberCountLabel }}
          </mj-text>
          <mj-text padding="20px 0 20px 0">
            <strong>{{ inviterName }}</strong> vous invite à rejoindre l’organisation
            <strong>{{ organizationName }}</strong> sur Cadenway, avec le rôle
            <strong>{{ roleLabel }}</strong
            >.
          </mj-text>
          <mj-button
            href="{{invitationUrl}}"
            align="left"
            background-color="#7c3aed"
            color="#ffffff"
          >
            Rejoindre {{ organizationName }}
          </mj-button>
          <mj-text color="#5f616a" font-size="12px" line-height="20px" padding="20px 0 0 0">
            L’invitation expire le {{ expiryDate }}. Vous ne connaissez pas {{ inviterFirstName }} ?
            Ignorez cet e-mail.
          </mj-text>
        </mj-column>
      </mj-section>
      <mj-section padding="24px 8px 0 8px">
        <mj-column>
          <mj-text
            align="center"
            color="#5f616a"
            font-size="12px"
            line-height="20px"
            padding="0 0 8px 0"
          >
            Vous recevez cet e-mail car un membre {{ ofOrganization }} a invité votre adresse.
          </mj-text>
          <mj-text align="center" color="#5f616a" font-size="12px" line-height="20px">
            Cadenway · 12 rue de la Charité, 69002 Lyon
          </mj-text>
        </mj-column>
      </mj-section>
    </mj-wrapper>
  </mj-body>
</mjml>
